# Copy this file to .env for local development.
# Keep real API keys in Railway Variables or your local ignored .env file only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Disha uses Gemini for Hindi chat, voice transcription, and Hindi speech.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Optional: otherwise Disha selects a Hindi female conversational voice from Gemini's voice library.
GEMINI_TTS_VOICE=
GEMINI_TTS_FALLBACK_VOICE=Kore

# Production visual search (required above the local development catalogue limit).
# Use managed PostgreSQL with the pgvector extension and a managed Redis instance.
REDIS_URL=
VISUAL_SEARCH_RPM=30
VISUAL_SEARCH_CACHE_SECONDS=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
WEB_CONCURRENCY=2
